#define MAIN_LAYER   0
#define MOVE_LAYER   1
#define SYM_LAYER    2
#define NUM_LAYER    3
#define MOUSE_LAYER  4
#define SCROLL_LAYER 5
#define SNIPE_LAYER  6
#define FN_LAYER     7
#define SYS_LAYER    8

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q        &kp W         &kp E     &kp R       &kp T                                     &kp Y            &kp U  &kp I      &kp O    &kp P
&mt LCTRL A  &kp S         &kp D     &kp F       &kp G                                     &kp H            &kp J  &kp K      &kp L    &kp SEMI
&mt LSHFT Z  &kp X         &kp C     &kp V       &kp B                                     &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL    &kp LEFT_WIN  &kp LALT  &lt 7 ESCAPE  &lt 1 ESCAPE  &lt 3 LA(GRAVE)  &kp SPACE  &lt 2 BACKSPACE                             &kp ENTER
            >;
        };

        move_layer {
            label = "MOVE";
            bindings = <
&none     &none     &none         &none      &none                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &none                   &kp PAGE_UP     &kp HOME        &kp DELETE    &kp END          &none
&none     &none     &none         &none      &none                   &kp PAGE_DOWN   &kp HOME        &none         &kp END          &none
&trans    &trans    &trans        &trans     &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp GRAVE        &kp HASH     &kp ASTERISK  &kp UNDERSCORE  &kp MINUS                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp EXCLAMATION  &kp AT_SIGN  &kp DOLLAR    &kp PERCENT     &trans                     &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans       &trans        &trans          &trans                     &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans       &trans        &trans          &trans     &trans  &trans  &trans                                                                 &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&none   &none  &none  &none   &none                        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH  &kp ASTERISK
&none   &none  &none  &none   &none                        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &kp MINUS
&none   &none  &none  &none   &none                        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT    &kp ENTER
&trans  &none  &none  &trans  &trans  &trans  &kp NUMBER_0  &trans                                               &kp ENTER
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 5   &mo 6                   &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &mo 6                   &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 5   &trans                  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &none  &none  &none  &none  &none
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                 &none  &none  &none  &none  &none
&kp F11  &kp F12  &none    &none    &none                   &none  &none  &none  &none  &none
&mo 8    &none    &none    &trans   &trans  &trans  &trans  &trans                        &mo 8
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
&none       &none  &none         &none         &none                    &none  &none  &none  &none  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none                 &none  &none  &none  &none  &none
&bt BT_CLR  &none  &none         &none         &none                    &none  &none  &none  &none  &none
&trans      &none  &bootloader   &none         &none  &none  &none  &none                  &none
            >;
        };
    };
};
