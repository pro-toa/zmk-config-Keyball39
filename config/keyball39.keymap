#define MAIN 0
#define SYM  1
#define NUM  2
#define FNMV 3

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    behaviors {
        kp_ht: keypress_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        lt_tog: layer_toggle_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&tog>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q        &kp W     &kp E     &kp R          &kp T                                        &kp_ht LPAR Y  &kp_ht RPAR U  &kp I      &kp O    &kp_ht TAB P
&mt CAPS A   &kp S     &kp D     &kp F          &kp G                                        &kp_ht LBKT H  &kp_ht RBKT J  &kp K      &kp L    &kp MINUS
&mt LSHFT Z  &kp X     &kp C     &kp V          &kp B                                        &kp N          &kp M          &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL    &kp LWIN  &kp LALT  &lt_tog 3 ESC  &lt_tog 2 SPACE  &lt_tog 1 GRAVE  &kp ENTER  &kp BSPC                                          &kp DEL
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp GRAVE &kp HASH     &kp ASTRK  &kp UNDER  &kp MINUS                  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR
&kp EXCL  &kp AT_SIGN  &kp DLLR   &kp PRCNT  &trans                     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp SQT
&trans    &trans       &trans     &trans     &trans                     &kp UNDER  &kp PLUS   &trans     &trans    &kp NUBS
&trans    &trans       &trans     &trans     &trans     &trans  &trans  &trans                                     &trans
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&none      &none   &none   &none   &none                      &kp N7          &kp N8  &kp N9  &kp ASTRK  &kp_ht TAB SLASH
&none      &none   &none   &none   &none                      &kp N4          &kp N5  &kp N6  &kp PLUS   &kp MINUS
&kp LCTRL  &none   &none   &none   &none                      &kp N1          &kp N2  &kp N3  &kp DOT    &kp NUBS
&trans     &trans  &trans  &trans  &trans  &trans  &kp ENTER  &kp_ht BSPC N0                             &kp EQUAL
            >;
        };

        function_and_move_layer {
            label = "FNMV";
            bindings = <
&kp F1      &kp F2   &kp F3        &kp F4        &kp F5                        &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&kp F6      &kp F7   &kp F8        &kp F9        &kp F10                       &kp PG_UP  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
&kp F11     &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                  &kp PG_DN  &kp HOME   &none      &kp END    &none
&bt BT_CLR  &none    &bootloader   &trans        &trans        &trans  &trans  &trans                                      &trans
            >;
        };
    };
};
