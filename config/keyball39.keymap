#define MAIN_LAYER   0
#define MOUSE_LAYER  1
#define SCROLL_LAYER 2
#define SNIPE_LAYER  3
#define SYM_LAYER    4
#define NUM_LAYER    5
#define FN_LAYER     6
#define SYS_LAYER    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        toggle_mouse_layer: toggle_mouse_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "toggle_mouse_layer";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&tog>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q      &kp W         &kp E     &kp R      &kp T                                            &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F      &kp G                                            &kp H          &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C     &kp V      &kp B                                            &kp N          &kp M  &kp COMMA  &kp DOT  &toggle_mouse_layer 1 ESCAPE
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &kp LSHFT  &kp SPACE  &toggle_mouse_layer 1 TAB  &kp ENTER  &kp BACKSPACE                             &lt 4 GRAVE
            >;
        };

        mouse_layer {
            label = "MOUSE MODE";
            bindings = <
&none      &none      &none      &none   &none                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 2   &mo 3                   &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &none
&none      &none      &none      &none   &none                   &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                                         &mo 2
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&none      &none      &none      &none   &none                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans                   &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK       &none
&none      &none      &none      &none   &none                   &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                                         &mo 3
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&none      &none      &none      &none   &none                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans                   &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK       &none
&none      &none      &none      &none   &none                   &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                                         &mo 2
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH     &kp DOLLAR    &kp PERCENT                   &kp AMPERSAND         &kp SQT            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
&kp AT_SIGN      &kp DOLLAR         &kp PERCENT  &kp QUESTION  &kp MINUS                     &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp ASTERISK          &kp UNDERSCORE         &kp PLUS
&kp LT           &kp GT             &kp PIPE     &kp COLON     &kp SEMICOLON                 &kp NON_US_BACKSLASH  &kp PLUS           &kp DOUBLE_QUOTES     &kp TILDE              &trans
&trans           &trans             &trans       &trans        &trans         &trans  &mo 5  &mo 6                                                                                 &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                  &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH                     &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                     &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&kp DOT       &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                   &kp DOT
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                 &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp F11  &kp F12  &none    &none    &none                   &kp F11  &kp F12  &none   &none   &none
&trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans                            &mo 7
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
&none   &none  &none  &none  &none                &none  &none         &none         &none         &bt BT_CLR
&none   &none  &none  &none  &none                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&none   &none  &none  &none  &none                &none  &none         &none         &none         &none
&trans  &none  &none  &none  &none  &none  &none  &none                                            &none
            >;
        };
    };
};
