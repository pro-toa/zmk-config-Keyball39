#define MAIN 0
#define NMF  1
#define SYM  2
#define MOVE 3

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    behaviors {
        kp_ht: kp_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q        &kp W     &kp E     &kp R    &kp T                                &kp_ht LPAR Y  &kp_ht RPAR U  &kp I      &kp O    &kp P
&mt CAPS A   &kp S     &kp D     &kp F    &kp G                                &kp_ht LBKT H  &kp_ht RBKT J  &kp K      &kp L    &kp MINUS
&mt LSHFT Z  &kp X     &kp C     &kp V    &kp B                                &kp N          &kp M          &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL    &kp LWIN  &kp LALT  &kp ESC  &lt 1 SPACE  &lt 2 GRAVE  &kp ENTER  &lt 3 BSPC                                         &kp DEL
            >;
        };

        nmf_layer {
            label = "NMF";
            bindings = <
&kp F1      &kp F2   &kp F3        &kp F4        &kp F5                        &kp N7          &kp N8  &kp N9  &kp SLASH  &kp ASTRK
&kp F6      &kp F7   &kp F8        &kp F9        &kp F10                       &kp N4          &kp N5  &kp N6  &kp PLUS   &trans
&kp F11     &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                  &kp N1          &kp N2  &kp N3  &kp DOT    &trans
&bt BT_CLR  &none    &bootloader   &trans        &trans        &trans  &trans  &kp_ht BSPC N0                             &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp GRAVE &kp HASH     &kp ASTRK  &kp UNDER  &kp MINUS                  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR
&kp EXCL  &kp AT_SIGN  &kp DLLR   &kp PRCNT  &trans                     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp SQT
&trans    &trans       &trans     &trans     &trans                     &kp UNDER  &kp PLUS   &trans     &trans    &kp NUBS
&trans    &trans       &trans     &trans     &trans     &trans  &trans  &trans                                     &trans
            >;
        };

        move_layer {
            label = "MOVE";
            bindings = <
&none      &none      &none     &none     &none                   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp TAB
&kp LCTRL  &kp LSHFT  &kp LALT  &kp LWIN  &none                   &kp PG_UP  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
&none      &none      &none     &none     &none                   &kp PG_DN  &kp HOME   &none      &kp END    &none
&trans     &trans     &trans    &trans    &trans  &trans  &trans  &trans                                      &trans
            >;
        };
    };
};
