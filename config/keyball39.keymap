#define MAIN 0
#define MOVE 1
#define SYM  2
#define NMF  3

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q        &kp W         &kp E     &kp R       &kp T                                 &kp Y            &kp U  &kp I      &kp O    &kp P
&mt CAPS A   &kp S         &kp D     &kp F       &kp G                                 &kp H            &kp J  &kp K      &kp L    &kp SEMI
&mt LSHFT Z  &kp X         &kp C     &kp V       &kp B                                 &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL    &kp LEFT_WIN  &kp LALT  &kp ESCAPE  &lt 1 ESCAPE  &lt 3 GRAVE  &kp SPACE  &lt 2 BACKSPACE                             &kp ENTER
            >;
        };

        move_layer {
            label = "MOVE";
            bindings = <
&none     &none     &none         &none      &none                   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &none                   &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &none
&none     &none     &none         &none      &none                   &kp PAGE_DOWN   &kp HOME        &none         &kp END          &none
&trans    &trans    &trans        &trans     &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp GRAVE        &kp HASH     &kp ASTERISK  &kp UNDERSCORE  &kp MINUS                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp EXCLAMATION  &kp AT_SIGN  &kp DOLLAR    &kp PERCENT     &trans                     &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans       &trans        &trans          &trans                     &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans       &trans        &trans          &trans     &trans  &trans  &trans                                                                 &trans
            >;
        };

        nmf_layer {
            label = "NMF";
            bindings = <
&kp F1      &kp F2   &kp F3        &kp F4        &kp F5                              &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH  &kp ASTERISK
&kp F6      &kp F7   &kp F8        &kp F9        &kp F10                             &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &kp MINUS
&kp F11     &kp F12  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT    &kp ENTER
&bt BT_CLR  &none    &bootloader   &trans        &trans        &trans  &kp NUMBER_0  &trans                                               &kp ENTER
            >;
        };
    };
};
