#define MAIN_LAYER   0
#define MOUSE_LAYER  1
#define SCROLL_LAYER 2
#define SNIPE_LAYER  3
#define SYM_LAYER    4
#define NUM_LAYER    5
#define FN_LAYER     6
#define SYS_LAYER    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* jp JIS symbols */
#define JP_HYPHEN       0x2D
#define JP_CARET        0x2E
#define JP_AT           0x2F
#define JP_LBKT         0x30
#define JP_RBKT         0x31
#define JP_SEMICOLON    0x33
#define JP_COLON        0x34
#define JP_COMMA        0x36
#define JP_PERIOD       0x37
#define JP_SLASH        0x38
#define JP_YEN          0x89
#define JP_PIPE         LS(0x89)
#define JP_UNDERSCORE   LS(0x87)

&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        toggle_mouse_layer: toggle_mouse_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "toggle_mouse_layer";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&tog>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q      &kp W         &kp E     &kp R      &kp T                                            &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F      &kp G                                            &kp H          &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C     &kp V      &kp B                                            &kp N          &kp M  &kp COMMA  &kp DOT  &toggle_mouse_layer 1 ESCAPE
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &kp LSHFT  &kp SPACE  &toggle_mouse_layer 1 TAB  &kp ENTER  &kp BACKSPACE                             &lt 4 GRAVE
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mo 0
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &mo 2
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &mo 3
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mo 2
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &mo 3
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &mo 2
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &mo 3
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp LS(NUMBER_1) &kp LS(NUMBER_2)   &kp LS(NUMBER_3) &kp LS(NUMBER_4)     &kp LS(NUMBER_5)                  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp JP_HYPHEN
&kp JP_AT        &kp JP_YEN         &kp LS(NUMBER_5) &kp LS(SLASH)        &kp JP_UNDERSCORE                 &kp COMMA         &kp PERIOD        &kp JP_LBKT       &kp JP_RBKT       &kp EQUAL
&kp LESS_THAN    &kp GREATER_THAN   &kp JP_PIPE      &kp NON_US_HASH &kp  LS(SINGLE_QUOTE)                  &kp COMMA         &kp PERIOD        &kp SLASH         &kp JP_YEN        &trans
&trans           &trans             &trans           &trans               &trans             &trans  &mo 5  &mo 6                                                                   &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                  &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH                     &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                     &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&kp DOT       &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                   &kp DOT
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                 &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp F11  &kp F12  &none    &none    &none                   &kp F11  &kp F12  &none   &none   &none
&trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans                            &mo 7
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
&none   &none  &none  &none  &none                &none  &none         &none         &none         &bt BT_CLR
&none   &none  &none  &none  &none                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&none   &none  &none  &none  &none                &none  &none         &none         &none         &none
&trans  &none  &none  &none  &none  &none  &none  &none                                            &none
            >;
        };
    };
};
