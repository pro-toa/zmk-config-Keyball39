#define MAIN_LAYER   0
#define MOUSE_LAYER  1
#define SCROLL_LAYER 2
#define SNIPE_LAYER  3
#define SYM_LAYER    4
#define NUM_LAYER    5
#define FN_LAYER     6
#define SYS_LAYER    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q      &kp W         &kp E     &kp R         &kp T                                &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F         &kp G                                &kp H          &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C     &kp V         &kp B                                &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &lt 4 ESCAPE  &kp SPACE  &kp LA(GRAVE)  &kp ENTER  &kp BACKSPACE                             &kp LSHFT
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 2   &mo 3                   &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &none
&trans     &trans     &trans     &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &none
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                                         &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &trans         &trans     &trans     &trans     &trans
&mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &mo 3                   &kp PAGE_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
&trans     &trans     &trans     &trans  &trans                  &kp PAGE_DOWN  &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans     &trans     &trans     &trans  &trans                  &trans         &trans     &trans     &trans     &trans
&mkp LCLK  &mkp MCLK  &mkp RCLK  &mo 2   &trans                  &kp PAGE_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
&trans     &trans     &trans     &trans  &trans                  &kp PAGE_DOWN  &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans                                          &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp GRAVE        &kp HASH     &kp ASTERISK  &kp UNDERSCORE  &kp MINUS                 &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp EXCLAMATION  &kp AT_SIGN  &kp DOLLAR    &kp PERCENT     &trans                    &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans       &trans        &trans          &trans                    &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans       &trans        &trans          &trans     &trans  &mo 5  &mo 6                                                                  &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                 &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH                    &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&kp DOT       &none         &none         &none         &none         &none  &trans  &none                                                   &kp DOT
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                 &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp F11  &kp F12  &none    &none    &none                   &kp F11  &kp F12  &none   &none   &none
&none    &none    &none    &trans   &trans  &trans  &trans  &trans                            &mo 7
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
&none   &none  &none  &none  &none                &none  &none         &none         &none         &bt BT_CLR
&none   &none  &none  &none  &none                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&none   &none  &none  &none  &none                &none  &none         &none         &none         &none
&trans  &none  &none  &none  &none  &none  &none  &none                                            &none
            >;
        };
    };
};
