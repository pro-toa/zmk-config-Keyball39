#define MAIN_LAYER   0
#define MOUSE_LAYER  1
#define SCROLL_LAYER 2
#define SNIPE_LAYER  3
#define SYM_LAYER    4
#define NUM_LAYER    5
#define FN_LAYER     6
#define SYS_LAYER    7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* jp JIS symbols */
#define JP_HYPHEN       0x2D
#define JP_CARET        0x2E
#define JP_AT           0x2F
#define JP_LBKT         0x30
#define JP_RBKT         0x31
#define JP_SEMICOLON    0x33
#define JP_COLON        0x34
#define JP_COMMA        0x36
#define JP_PERIOD       0x37
#define JP_SLASH        0x38
#define JP_YEN          0x89

&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        shift_backspace_delete: shift_backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            label = "shift_backspace_delete";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        main_layer {
            label = "MAIN";
            bindings = <
&kp Q      &kp W         &kp E     &kp R      &kp T                                            &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F      &kp G                                            &kp H          &kp J  &kp K      &kp L    &kp MINUS
&kp Z      &kp X         &kp C     &kp V      &kp B                                            &kp N          &kp M  &kp COMMA  &kp DOT  &kp ESCAPE
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &kp LSHFT  &kp SPACE  &kp TAB  &kp ENTER  &shift_backspace_delete                                     &lt 4 GRAVE
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &to 0
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &mo 2
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &mo 3
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_UP     &mkp LCLK       &mkp MCLK     &mkp RCLK        &trans
&trans  &trans  &trans  &trans  &trans                  &kp PAGE_DOWN   &kp HOME        &none         &kp END          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp LS(N1)     &kp LS(N2)        &kp LS(N3)      &kp LS(N4)        &kp LS(N5)                           &kp LS(N6)        &kp LS(N7)    &kp LS(N8)   &kp LS(N9)   &kp JP_HYPHEN
&kp JP_AT      &kp JP_YEN        &kp LS(N5)      &kp LS(SLASH)     &kp LS(0x87)                         &kp JP_SEMICOLON  &kp JP_COLON  &kp JP_LBKT  &kp JP_RBKT  &kp JP_CARET
&kp LESS_THAN  &kp GREATER_THAN  &kp LS(JP_YEN)  &kp LS(JP_CARET)  &kp LS(SINGLE_QUOTE)                 &kp COMMA         &kp PERIOD    &kp SLASH    &kp JP_YEN   &trans
&trans         &trans            &trans          &trans            &trans                &trans  &mo 5  &mo 6                                                     &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
&kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                  &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK
&kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH                     &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                     &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&kp DOT       &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                   &kp DOT
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                 &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&kp F11  &kp F12  &none    &none    &none                   &kp F11  &kp F12  &none   &none   &none
&trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans                            &mo 7
            >;
        };

        sys_layer {
            label = "SYS";
            bindings = <
&none   &none  &none  &none  &none                &none  &none         &none         &none         &bt BT_CLR
&none   &none  &none  &none  &none                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
&none   &none  &none  &none  &none                &none  &none         &none         &none         &none
&trans  &none  &none  &none  &none  &none  &none  &none                                            &none
            >;
        };
    };
};
